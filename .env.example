# CTAID POC demo environment variables.
# Copy to .env for local use. .env is git ignored. Never commit real values.

# ---------------------------------------------------------------------------
# Optional: Convex for dataset metadata, model versions and prediction history.
# Leave CONVEX_URL empty to use the local SQLite backend in var/.
# ---------------------------------------------------------------------------
CONVEX_URL=
CONVEX_DEPLOY_KEY=

# ---------------------------------------------------------------------------
# Optional: Garage S3 for CSV uploads and model artifacts.
# Leave S3_ENDPOINT empty to store objects under var/objects.
# ---------------------------------------------------------------------------
S3_ENDPOINT=
S3_BUCKET=ctaid-poc-demo
S3_REGION=garage
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---------------------------------------------------------------------------
# Optional overrides for paths. Defaults work for a normal checkout.
# ---------------------------------------------------------------------------
CTAID_DATA_PATH=
CTAID_MODELS_DIR=
CTAID_STATE_DIR=
